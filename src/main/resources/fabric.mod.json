{
	"schemaVersion": 1,
	"id": "easy-portal-linking",
	"version": "${version}",
	"name": "Easy Portal Linking",
	"description": "This is an example description! Tell everyone what your mod is about!",
	"authors": [
		"Me!"
	],
	"contact": {
		"homepage": "https://fabricmc.net/",
		"sources": "https://github.com/FabricMC/fabric-example-mod"
	},
	"license": "CC0-1.0",
	"icon": "assets/easy-portal-linking/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			{
				"value": "redpandalover.easyportallinking.EasyPortalLinking",
				"adapter": "kotlin"
			}
		],
		"client": [
			{
				"value": "redpandalover.easyportallinking.EasyPortalLinkingClient",
				"adapter": "kotlin"
			}
		]
	},
	"mixins": [
		"easy-portal-linking.mixins.json",
		{
			"config": "easy-portal-linking.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.18.3",
		"minecraft": "~1.21.10",
		"java": ">=21",
		"fabric-api": "*",
		"fabric-language-kotlin": "*"
	}
}